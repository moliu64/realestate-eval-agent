# 本地运行配置（无需域名、隧道或公网部署）

# OpenAI-compatible chat endpoint. Any vendor that speaks the OpenAI protocol
# works (DeepSeek, Qwen/DashScope, GLM, OpenAI, ...).
OPENAI_BASE_URL=
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Local embedding model. Chat and embedding stay separated on purpose: most
# OpenAI-compatible chat endpoints do not expose an embedding API.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Storage paths (relative to the project root or absolute).
DOCS_DIR=data/docs
VECTOR_DB_DIR=data/vector_db
SESSIONS_DIR=data/sessions
AUTH_USERS_FILE=data/auth_users.json

# Retrieval.
RETRIEVAL_TOP_K=4
MIN_RELEVANCE_SCORE=0.5

# Optional vision model for floor-plan images (Qwen-VL or another compatible model).
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus

# Login accounts. Keep this JSON in .env only and change the values before use.
# Registered regular users are stored in AUTH_USERS_FILE instead.
# Example: {"admin":{"password":"change-admin-password","role":"admin"},"analyst":{"password":"change-user-password","role":"user"}}
AUTH_USERS_JSON={}

# Local web server. Keep 127.0.0.1 for a local-only project.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
