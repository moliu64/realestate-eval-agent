# OpenAI-compatible chat endpoint.
# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
OPENAI_BASE_URL=
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Local embedding model. Keep chat and embedding separated.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Local project paths.
DOCS_DIR=data/docs
VECTOR_DB_DIR=data/vector_db
RETRIEVAL_TOP_K=4
MIN_RELEVANCE_SCORE=0.5

# Qwen-VL via DashScope OpenAI-compatible endpoint. Optional until images are indexed.
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-your-dashscope-key
VISION_MODEL=qwen-vl-plus

# Required for /admin endpoints; use a long random value in deployment.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Login accounts. Change these values before deployment; keep this JSON in .env only.
# Example: {"admin":{"password":"change-admin-password","role":"admin"},"analyst":{"password":"change-user-password","role":"user"}}
AUTH_USERS_JSON={}

# Web UI.
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_HOST=060115.top
# Separate frontend dev server, for example http://127.0.0.1:5173.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Standalone frontend server.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_OPEN_BROWSER=1
BACKEND_URL=http://127.0.0.1:8000
